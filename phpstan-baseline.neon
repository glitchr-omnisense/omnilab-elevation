parameters:
	ignoreErrors:
		-
			message: '#^Argument of an invalid type mixed supplied for foreach, only iterables are supported\.$#'
			identifier: foreach.nonIterable
			count: 1
			path: ElevationSource.php

		-
			message: '#^Cannot access offset ''dataset'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: ElevationSource.php

		-
			message: '#^Cannot access offset ''elevation'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: ElevationSource.php

		-
			message: '#^Cannot access offset ''location'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: ElevationSource.php

		-
			message: '#^Cannot cast mixed to float\.$#'
			identifier: cast.double
			count: 1
			path: ElevationSourceFactory.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 3
			path: ElevationSourceFactory.php

		-
			message: '#^Parameter \#1 \$callback of function array_map expects \(callable\(mixed\)\: mixed\)\|null, ''trim'' given\.$#'
			identifier: argument.type
			count: 1
			path: ElevationSourceFactory.php

		-
			message: '#^Call to an undefined method Omnilab\\Source\\SourceInterface\:\:at\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: Tests/ElevationSourceTest.php

		-
			message: '#^Method Omnilab\\Elevation\\Tests\\ElevationSourceTest\:\:source\(\) has parameter \$options with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: Tests/ElevationSourceTest.php

		-
			message: '#^Parameter \#1 \$body of class Symfony\\Component\\HttpClient\\Response\\MockResponse constructor expects iterable\<string\|Throwable\>\|string, string\|false given\.$#'
			identifier: argument.type
			count: 2
			path: Tests/ElevationSourceTest.php

		-
			message: '#^Parameter \#1 \$options of method Omnilab\\Source\\SourceFactory\:\:create\(\) expects array\<string, mixed\>, array given\.$#'
			identifier: argument.type
			count: 1
			path: Tests/ElevationSourceTest.php

		-
			message: '#^Parameter \#2 \$haystack of static method PHPUnit\\Framework\\Assert\:\:assertCount\(\) expects Countable\|iterable, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: Tests/ElevationSourceTest.php

		-
			message: '#^Property Omnilab\\Elevation\\Tests\\ElevationSourceTest\:\:\$calls \(list\<array\{string, array\<string, string\>\}\>\) does not accept non\-empty\-list\<array\{string, array\<int\|string, array\<mixed\>\|string\>\}\>\.$#'
			identifier: assign.propertyType
			count: 1
			path: Tests/ElevationSourceTest.php
